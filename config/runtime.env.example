# AI Council non-secret runtime configuration
#
# Installed by scripts/deploy_runtime.sh as /etc/ai-council/runtime.env when
# that file does not already exist. Do not put tokens, passwords, private keys,
# cookies, or application secrets in this file.

AI_COUNCIL_GITHUB_REPO=crazyathlete220-stack/ai-council-private
AI_COUNCIL_GITHUB_JOB_LABEL=vps-job
AI_COUNCIL_GITHUB_ALLOWED_USERS_FILE=/etc/ai-council/github-bridge-allowlist
AI_COUNCIL_WORKSPACE_REGISTRY_DIR=/etc/ai-council/workspaces.d
AI_COUNCIL_JOB_ROOT=/var/lib/ai-council/jobs
AI_COUNCIL_GITHUB_BRIDGE_STATE_ROOT=/var/lib/ai-council/github-bridge
AI_COUNCIL_GITHUB_BRIDGE_LOG_DIR=/var/log/ai-council/github-bridge
AI_COUNCIL_JOB_LOG_DIR=/var/log/ai-council/jobs
AI_COUNCIL_AI_WORKER_LOG_ROOT=/var/log/ai-council/ai-worker
