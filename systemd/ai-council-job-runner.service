[Unit]
Description=AI Council job runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-council
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/root/.config
EnvironmentFile=-/etc/ai-council/github-bridge.env
ExecStart=/opt/ai-council/scripts/run_job_cycle.sh
